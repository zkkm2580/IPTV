<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- VideoLAN LibVLC 核心视频渲染层 -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部状态栏（时钟、画幅比例与设置入口） -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="end|center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_aspect_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_osd_bar"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:text="16:9" />

        <TextView
            android:id="@+id/tv_btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_osd_bar"
            android:textColor="#E5E7EB"
            android:textSize="13sp"
            android:text="设置" />

        <TextView
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:text="00:00" />
    </LinearLayout>

    <!-- 底部沉浸式 OSD 换台与 EPG 节目信息栏 -->
    <LinearLayout
        android:id="@+id/layout_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="32dp"
        android:background="@drawable/bg_osd_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_osd_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:text="01" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_osd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="频道名称" />

            <TextView
                android:id="@+id/tv_osd_epg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:text="EPG 节目单获取中..." />

            <TextView
                android:id="@+id/tv_osd_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:text="未分类 · LibVLC 硬解" />
        </LinearLayout>
    </LinearLayout>

    <!-- 缓冲与连接状态提示 -->
    <LinearLayout
        android:id="@+id/layout_buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/tv_buffer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:text="LibVLC 正在解封装直播流..." />
    </LinearLayout>

    <!-- 无内置频道时的初始引导与配置提示 -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osd_bar"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📺 暂无播放源"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="已取消硬编码内置频道，请点击下方配置您的 M3U/M3U8 直播源"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_config_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#2563EB"
            android:text="配置 M3U 播放源与代理" />
    </LinearLayout>

    <!-- 左侧频道与分类双层抽屉选台菜单 (遥控器按 OK 呼出) -->
    <LinearLayout
        android:id="@+id/layout_channel_drawer"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 左侧分类列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_groups"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:background="#33000000" />

        <!-- 右侧频道列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
